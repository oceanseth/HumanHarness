# Twitch stream to ride. Leave unset (with MOCK_INGEST=true) to demo without a stream.
TWITCH_CHANNEL=yourragegaming

# Demo mode replaces Twitch/streamlink/ffmpeg with scripted scene labels.
# It does not bypass LaserData, FalkorDB, RocketRide, Guild, or MiniMax.
MOCK_INGEST=false

# MiniMax — token-plan image understanding + persona crew.
# MINIMAX_KEY must be a Global key when using the default .io host.
MINIMAX_KEY=sk-cp-XQx9rv_5s99xl78GyItYvRE-xRZExbvC0Vgru0zIi23sie6yyEjMCjSkTeNlDPRM5C-SB5YUruGdK36OHU8yB90K6eZ8DonqHiv0vLVngIrc2D89h0bnFEY
MINIMAX_API_HOST=https://api.minimax.io
CREW_MODEL=MiniMax-M2.7

# LaserData — real-time signal stream (Apache Iggy over VSR, via @laserdata/laser-sdk).
# Required. Missing credentials or an unreachable data-plane endpoint blocks startup.
#
# Either set the whole connection target from the Console's Credentials tab...
#   LASER_CONNECTION_STRING=<token>@starter-xxxx.us-east-1.aws.laserdata.cloud
# ...or give the parts and let config.js assemble them:
LASER_CONNECTION_STRING=root:RpiWuSz2dX74TkqRxAV02snlf1RUzoHW4rxn@starter-fiksx-g98kzfurrawp7.us-east-1.aws.laserdata.cloud
LASERDATA_DOMAIN=starter-fiksx-g98kzfurrawp7.us-east-1.aws.laserdata.cloud
LASERDATA_TOKEN=
LASERDATA_USERNAME=root
LASERDATA_PASSWORD=RpiWuSz2dX74TkqRxAV02snlf1RUzoHW4rxn
LASERDATA_STREAM=humanharness-live
LASERDATA_TOPIC=signals

# Control-plane credentials (api.laserdata.cloud, `ld-api-key` header). They are
# retained in config for hackathon tooling but cannot publish signal data.
LASERDATA_API_KEY=ngxT2wu9kF7ZG6X2baQWXoIWhwV6m9Xq8KklbFfn9a4JrkHpyepCCmgFDaZvaGHl
LASERDATA_TENANT_ID=631259996528574804

# FalkorDB — required graph memory. Missing/unreachable blocks startup.
# Use redis:// or rediss:// exactly as shown by the instance's Connect page.
# Free tier: stops after 1 day idle.
FALKORDB_URL=redis://falkordb:Aa1!6laorzvShIImVsge87GMKzpQQEWC@r-6jissuruar.instance-8j8f8byds.hc-7up0crkyn.ap-south-1.aws.f2e0a955bb84.cloud:52491
FALKORDB_CONNECTION_STRING=
FALKORDB_GRAPH=humanharness
FALKORDB_GRAPH_PASSWORD=Aa1!6laorzvShIImVsge87GMKzpQQEWC

# RocketRide.ai — action orchestration for the Scout's lookups, run as a
# pipeline on RocketRide Cloud. Required; startup blocks unless its task is ready.
# The pipeline's native MiniMax node uses MINIMAX_KEY, so both keys are required.
ROCKETRIDE_API_KEY=rr_b4c8ace860287915e4d5d57fa15ab4d0
ROCKETRIDE_MODEL=MiniMax-M2.7

# Guild.ai API trigger — required remote persona routing. Startup runs real
# routed canaries through all four specialists and blocks if any one fails.
# GUILD_API_KEY is the combined <api_key_id>:<api_key_secret> shown once when
# creating an API trigger. GUILD_WORKSPACE_OWNER and GUILD_WORKSPACE are the
# two URL slugs from https://app.guild.ai/workspaces/<owner>/<workspace>.
GUILD_API_KEY=019fca91-6f12-7499-0000-5c3e92123d10:gldt_QYHtA2T7VpsDX76uiqEdxBIs3tU1qtav59TzCnONnoH
GUILD_WORKSPACE_OWNER=human-harness
GUILD_WORKSPACE=humanharness
GUILD_BASE_URL=https://app.guild.ai
GUILD_TIMEOUT_MS=60000
GUILD_POLL_INTERVAL_MS=1000

# masky.ai — per-persona voices. Unconfigured personas use browser speechSynthesis.
# MASKY_AVATAR_* is the legacy default; persona-specific values override it.
MASKY_API_KEY=mky_17cbf9e61e7be3caa065e66ae5e0ce2ac3980a1fd6bb8c4d
MASKY_AVATAR_ID=
MASKY_AVATAR_OWNER_USER_ID=
MASKY_STRATEGIST_AVATAR_ID=
MASKY_STRATEGIST_AVATAR_OWNER_USER_ID=
MASKY_HISTORIAN_AVATAR_ID=JPcH8au0rGpXXBEcCaGP
MASKY_HISTORIAN_AVATAR_OWNER_USER_ID=twitch:11867613
MASKY_HYPECASTER_AVATAR_ID=
MASKY_HYPECASTER_AVATAR_OWNER_USER_ID=
MASKY_SCOUT_AVATAR_ID=
MASKY_SCOUT_AVATAR_OWNER_USER_ID=

# STT for the human's speech: deepgram | whisper | none
STT_PROVIDER=none
DEEPGRAM_API_KEY=
OPENAI_API_KEY=

# Pipeline tuning
FRAME_INTERVAL_MS=500
LABEL_INTERVAL_MS=2000
COMMENTARY_INTERVAL_MS=8000

# Delayed spectate viewer: the app plays the stream (real video+audio, via a
# local HLS remux) this far behind the live edge, and schedules each crew clip
# onto the moment it was captured for. 0 = live mode (2fps frame preview,
# immediate commentary). Ignored in mock mode.
VIEWER_DELAY_MS=120000
