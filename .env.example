# Twitch stream to ride. Leave unset (with MOCK_INGEST=true) to demo without a stream.
TWITCH_CHANNEL=your_channel_name

# Demo mode: emits scripted scene labels on a timer instead of pulling a stream.
# Lets the whole crew loop run with no streamlink/ffmpeg and no Twitch.
MOCK_INGEST=false

# MiniMax — vision labeling + persona crew.
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
VISION_MODEL=abab6.5t-chat
CREW_MODEL=abab6.5t-chat

# LaserData — real-time signal stream (Apache Iggy over VSR, via @laserdata/laser-sdk).
# Unset connection = local in-process event bus.
#
# Either set the whole connection target from the Console's Credentials tab...
#   LASER_CONNECTION_STRING=<token>@starter-xxxx.us-east-1.aws.laserdata.cloud
# ...or give the parts and let config.js assemble them:
LASERDATA_DOMAIN=
LASERDATA_TOKEN=
LASERDATA_USERNAME=
LASERDATA_PASSWORD=
LASERDATA_STREAM=humanharness-live
LASERDATA_TOPIC=signals

# Control-plane only (api.laserdata.cloud, `ld-api-key` header): manages tenants
# and deployments. These CANNOT publish signals — the app never reads them.
LASERDATA_API_KEY=
LASERDATA_TENANT_ID=

# FalkorDB — graph memory. Unset/unreachable = in-memory graph fallback.
FALKORDB_URL=redis://localhost:6379
FALKORDB_GRAPH=humanharness

# RocketRide.ai — action orchestration. Unset key = mock (no external actions).
ROCKETRIDE_API_KEY=

# Guild.ai — multi-agent routing. Unset key = local router.
GUILD_API_KEY=

# masky.ai — persona voices. Unset key = browser speechSynthesis voices.
# Requires a pre-existing avatar (create one at https://masky.ai/developer).
MASKY_API_KEY=
MASKY_AVATAR_ID=
MASKY_AVATAR_OWNER_USER_ID=

# STT for the human's speech: deepgram | whisper | none
STT_PROVIDER=none
DEEPGRAM_API_KEY=
OPENAI_API_KEY=

# Pipeline tuning
FRAME_INTERVAL_MS=500
LABEL_INTERVAL_MS=2000
COMMENTARY_INTERVAL_MS=8000
