# Stream source
TWITCH_CHANNEL=your_channel_name
FRAME_INTERVAL_MS=500
LABEL_INTERVAL_MS=2000
COMMENTARY_INTERVAL_MS=8000

# Demo mode: emits scripted scene labels on a timer instead of pulling a stream.
MOCK_INGEST=false

# Real-time signals (LaserData)
LASERDATA_DOMAIN=
LASERDATA_TOKEN=
LASERDATA_USERNAME=
LASERDATA_PASSWORD=
LASERDATA_STREAM=humanharness-live
LASERDATA_TOPIC=signals
LASERDATA_API_KEY=
LASERDATA_TENANT_ID=

# Persistent memory (FalkorDB)
FALKORDB_URL=redis://localhost:6379
FALKORDB_GRAPH=humanharness

# Agent orchestration and voices
ROCKETRIDE_API_KEY=
GUILD_API_KEY=
MASKY_API_KEY=
MASKY_AVATAR_ID=
MASKY_AVATAR_OWNER_USER_ID=

# Speech-to-text: deepgram | whisper | none
STT_PROVIDER=none
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
